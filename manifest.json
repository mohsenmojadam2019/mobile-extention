{
  "manifest_version": 3,
  "name": "Responsive Device Switcher",
  "version": "1.0.0",
  "description": "One-click responsive QA for Apple, Samsung, Xiaomi and custom mobile viewports.",
  "permissions": ["activeTab", "tabs", "debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Responsive Device Switcher",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-responsive": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Toggle responsive emulation"
    }
  }
}
